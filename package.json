{
	"name": "notploy",
	"private": true,
	"scripts": {
		"dev": "pnpm --filter=@notploy/app run dev",
		"start": "pnpm --filter=@notploy/app run start",
		"setup": "pnpm --filter=@notploy/app run setup",
		"build": "pnpm -r run build",
		"build:app": "pnpm --filter=@notploy/app run build",
		"test": "pnpm --filter=@notploy/app run test",
		"typecheck": "pnpm -r run typecheck",
		"server:script": "pnpm --filter=@notploy/server run switch:dev",
		"server:dev": "pnpm --filter=@notploy/server run dev",
		"server:build": "pnpm --filter=@notploy/server run build",
		"web:dev": "pnpm --filter=@notploy/website run dev",
		"web:build": "pnpm --filter=@notploy/website run build",
		"docs:dev": "pnpm --filter=@notploy/docs run dev",
		"docs:build": "pnpm --filter=@notploy/docs run build",
		"docker:build:canary": "./apps/notploy/docker/build.sh canary",
		"lint": "biome check .",
		"format-and-lint": "biome check .",
		"check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"format-and-lint:fix": "biome check . --write",
		"generate:openapi": "pnpm --filter=@notploy/app run generate:openapi"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/node": "^24.4.0",
		"dotenv": "16.4.5",
		"esbuild": "0.20.2",
		"lint-staged": "^15.5.2",
		"tsx": "4.22.4"
	},
	"packageManager": "pnpm@10.22.0",
	"engines": {
		"node": "^24.4.0",
		"pnpm": ">=9.12.0"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"resolutions": {
		"@types/react": "18.3.5",
		"@types/react-dom": "18.3.0"
	},
	"pnpm": {
		"overrides": {
			"esbuild": "0.20.2",
			"better-call": "1.3.7",
			"@better-fetch/fetch": "1.3.1",
			"tar": ">=7.5.19 <8.0.0",
			"protobufjs": ">=7.5.5 <8.0.0"
		},
		"peerDependencyRules": {
			"ignoreMissing": [
				"prisma",
				"@prisma/client",
				"@prisma/engines",
				"@electric-sql/pglite",
				"typescript",
				"drizzle-kit"
			]
		},
		"onlyBuiltDependencies": [
			"@scarf/scarf",
			"@tree-sitter-grammars/tree-sitter-yaml",
			"bcrypt",
			"better-sqlite3",
			"core-js-pure",
			"cpu-features",
			"esbuild",
			"msgpackr-extract",
			"node-pty",
			"protobufjs",
			"sharp",
			"ssh2",
			"tree-sitter",
			"tree-sitter-json"
		]
	}
}
