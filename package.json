{
	"name": "notploy",
	"private": true,
	"scripts": {
		"dev": "pnpm --filter=@notploy/app run dev",
		"start": "pnpm --filter=@notploy/app run start",
		"setup": "pnpm --filter=@notploy/app run setup",
		"build": "pnpm -r run build",
		"build:app": "pnpm --filter=@notploy/app run build",
		"test": "pnpm --filter=@notploy/app run test",
		"typecheck": "pnpm -r run typecheck",
		"server:script": "pnpm --filter=@notploy/server run switch:dev",
		"server:dev": "pnpm --filter=@notploy/server run dev",
		"server:build": "pnpm --filter=@notploy/server run build",
		"web:dev": "pnpm --filter=@notploy/website run dev",
		"web:build": "pnpm --filter=@notploy/website run build",
		"docs:dev": "pnpm --filter=@notploy/docs run dev",
		"docs:check": "node scripts/docs/cli.mjs check",
		"docs:check:changed": "node scripts/docs/cli.mjs check --changed",
		"docs:check:coverage": "node scripts/docs/cli.mjs coverage",
		"docs:check:links": "node scripts/docs/cli.mjs check --only links",
		"docs:generate": "node scripts/docs/cli.mjs generate",
		"docs:test": "node --test scripts/docs/tests/*.test.mjs",
		"docs:build": "node scripts/docs/cli.mjs check --only spec,regions,links && pnpm --filter=@notploy/docs run build:docs && pnpm --filter=@notploy/docs run build && pnpm --filter=@notploy/docs run build:static-redirects",
		"templates:dev": "pnpm --filter=@notploy/templates-app run dev",
		"templates:build": "pnpm --filter=@notploy/templates-app run build",
		"templates:typecheck": "pnpm --filter=@notploy/templates-app run typecheck",
		"templates:test": "pnpm --filter=@notploy/templates-app run test",
		"desktop:dev": "pnpm --filter=@notploy/app run desktop:dev",
		"desktop:build": "pnpm --filter=@notploy/app run desktop:build",
		"desktop:start": "pnpm --filter=@notploy/app run desktop:start",
		"desktop:package": "pnpm --filter=@notploy/app run desktop:package",
		"desktop:typecheck": "pnpm --filter=@notploy/app run desktop:typecheck",
		"desktop:test": "pnpm --filter=@notploy/app run desktop:test",
		"docker:build:canary": "./apps/notploy/docker/build.sh canary",
		"lint": "pnpm -r run lint",
		"format-and-lint": "pnpm -r run lint",
		"check": "pnpm -r run lint",
		"format-and-lint:fix": "pnpm -r run lint:fix",
		"generate:openapi": "pnpm --filter=@notploy/app run generate:openapi",
		"changeset": "changeset",
		"changeset:add": "changeset add",
		"changeset:status": "changeset status",
		"changeset:version": "changeset version"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@changesets/changelog-github": "^1.0.1",
		"@changesets/cli": "^2.29.7",
		"@commitlint/cli": "^19.3.0",
		"@commitlint/config-conventional": "^19.2.2",
		"@tryghost/content-api": "^1.12.12",
		"@types/node": "^24.4.0",
		"@types/tryghost__content-api": "^1.3.17",
		"dotenv": "16.4.5",
		"esbuild": "0.28.2",
		"lint-staged": "^15.5.2",
		"toml": "3.0.0",
		"tsx": "4.22.4",
		"yaml": "2.9.1"
	},
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": "^24.4.0",
		"pnpm": ">=10.22.0"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"resolutions": {
		"@types/react": "18.3.5",
		"@types/react-dom": "18.3.0"
	},
	"dependencies": {
		"@skygenesisenterprise/react-sds": "^1.0.0",
		"ldapts": "^9.2.0",
		"node-forge": "^1.4.0"
	}
}
