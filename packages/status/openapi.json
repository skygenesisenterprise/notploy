	"components": {
		"securitySchemes": {
			"bearerAuth": {
				"type": "http",
				"scheme": "bearer",
				"bearerFormat": "nps_<tokenId>_<secret>",
				"description": "Token created via the admin API or the token:create CLI. Scopes: read, write, publish, ingest, tokens, admin."
			}
		},
		"schemas": {
			"GlobalStatus": {
				"type": "string",
				"enum": [
					"operational",
					"degraded_performance",
					"partial_outage",
					"major_outage",
					"under_maintenance"
				]
			},
			"PublicComponent": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"description": {
						"type": "string"
					},
					"category": {
						"type": "string"
					},
					"groupName": {
						"type": "string",
						"nullable": true
					},
					"position": {
						"type": "integer"
					},
					"status": {
						"$ref": "#/components/schemas/GlobalStatus"
					},
					"stale": {
						"type": "boolean"
					},
					"observedAt": {
						"type": "string",
						"format": "date-time",
						"nullable": true
					},
					"incidentIds": {
						"type": "array",
						"items": {
							"type": "string"
						}
					}
				}
			},
			"PublicIncident": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string"
					},
					"title": {
						"type": "string"
					},
					"severity": {
						"type": "string",
						"enum": ["minor", "major", "critical"]
					},
					"state": {
						"type": "string",
						"enum": ["investigating", "identified", "monitoring", "resolved"]
					},
					"startedAt": {
						"type": "string",
						"format": "date-time"
					},
					"resolvedAt": {
						"type": "string",
						"format": "date-time",
						"nullable": true
					},
					"componentIds": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"summary": {
						"type": "string"
					},
					"updates": {
						"type": "array",
						"items": {
							"type": "object"
						}
					}
				}
			},
			"PublicPage": {
				"type": "object",
				"properties": {
					"slug": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"description": {
						"type": "string"
					},
					"status": {
						"$ref": "#/components/schemas/GlobalStatus"
					},
					"stale": {
						"type": "boolean"
					},
					"generatedAt": {
						"type": "string",
						"format": "date-time"
					},
					"updatedAt": {
						"type": "string",
						"format": "date-time"
					},
					"refreshIntervalSeconds": {
						"type": "integer"
					},
					"components": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/PublicComponent"
						}
					},
					"activeIncidents": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/PublicIncident"
						}
					},
					"scheduledMaintenances": {
						"type": "array",
						"items": {
							"type": "object"
						}
					}
				}
			},
			"PageSummary": {
				"type": "object",
				"properties": {
					"slug": {
						"type": "string"
					},
					"name": {
						"type": "string"
					},
					"status": {
						"$ref": "#/components/schemas/GlobalStatus"
					},
					"stale": {
						"type": "boolean"
					}
				}
			},
			"PaginatedIncidents": {
				"type": "object",
				"properties": {
					"items": {
						"type": "array",
						"items": {
							"$ref": "#/components/schemas/PublicIncident"
						}
					},
					"nextCursor": {
						"type": "string",
						"nullable": true
					}
				}
			},
			"CreatePage": {
				"type": "object",
				"required": ["slug", "name"],
				"properties": {
					"slug": {
						"type": "string",
						"pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
					},
					"name": {
						"type": "string"
					},
					"description": {
						"type": "string"
					},
					"settings": {
						"type": "object",
						"additionalProperties": true
					}
				}
			},
			"CreateIncident": {
				"type": "object",
				"required": ["title"],
				"properties": {
					"title": {
						"type": "string"
					},
					"description": {
						"type": "string"
					},
					"severity": {
						"type": "string",
						"enum": ["minor", "major", "critical"]
					},
					"state": {
						"type": "string",
						"enum": ["investigating", "identified", "monitoring", "resolved"]
					},
					"visibility": {
						"type": "string",
						"enum": ["public", "private"]
					},
					"published": {
						"type": "boolean"
					},
					"componentIds": {
						"type": "array",
						"items": {
							"type": "string"
						}
					},
					"correlationKey": {
						"type": "string"
					},
					"update": {
						"type": "object",
						"additionalProperties": true
					}
				}
			},
			"CreateToken": {
				"type": "object",
				"required": ["name", "scopes"],
				"properties": {
					"name": {
						"type": "string"
					},
					"scopes": {
						"type": "array",
						"items": {
							"type": "string",
							"enum": ["read", "write", "publish", "ingest", "tokens", "admin"]
						}
					}
				}
			},
			"IngestEvent": {
				"type": "object",
				"required": ["pageSlug", "correlationKey", "title"],
				"properties": {
					"eventId": {
						"type": "string",
						"description": "Client-side idempotency key"
					},
					"pageSlug": {
						"type": "string"
					},
					"componentId": {
						"type": "string"
					},
					"correlationKey": {
						"type": "string",
						"description": "Groups repeated alerts into one incident"
					},
					"title": {
						"type": "string"
					},
					"message": {
						"type": "string"
					},
					"severity": {
						"type": "string",
						"enum": ["minor", "major", "critical"]
					},
					"observedStatus": {
						"type": "string",
						"enum": ["operational", "degraded", "outage", "unknown"]
					},
					"source": {
						"type": "string"
					},
					"updateComponentState": {
						"type": "boolean"
					}
				}
			}
		}
	}
}
