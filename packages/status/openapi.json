{
	"openapi": "3.1.0",
	"info": {
		"title": "Notploy Status API",
		"version": "1.0.0",
		"description": "Public and administration API of the Notploy Status platform. Public routes are read-only and unauthenticated; administration and integration routes require a bearer token with the matching scope (read, write, publish, ingest, tokens, admin)."
	},
	"servers": [
		{
			"url": "http://localhost:3000",
			"description": "This instance"
		}
	],
	"paths": {
		"/api/v1/pages": {
			"get": {
				"summary": "List public status pages",
				"responses": {
					"200": {
						"description": "Pages with their computed global status",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"items": {
											"type": "array",
											"items": {
												"$ref": "#/components/schemas/PageSummary"
											}
										}
									}
								}
							}
						}
					},
					"429": {
						"description": "Rate limited",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"error": {
											"type": "object",
											"properties": {
												"code": {
													"type": "string"
												},
												"message": {
													"type": "string"
												},
												"details": {
													"type": "object",
													"additionalProperties": true
												}
											},
											"required": ["code", "message"]
										}
									},
									"required": ["error"]
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/pages/{slug}": {
			"get": {
				"summary": "Full public state of one status page",
				"parameters": [
					{
						"name": "slug",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Public page projection",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PublicPage"
								}
							}
						}
					},
					"404": {
						"description": "Unknown page",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"error": {
											"type": "object",
											"properties": {
												"code": {
													"type": "string"
												},
												"message": {
													"type": "string"
												},
												"details": {
													"type": "object",
													"additionalProperties": true
												}
											},
											"required": ["code", "message"]
										}
									},
									"required": ["error"]
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/pages/{slug}/status": {
			"get": {
				"summary": "Global status indicator only",
				"parameters": [
					{
						"name": "slug",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Global status",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"slug": {
											"type": "string"
										},
										"status": {
											"$ref": "#/components/schemas/GlobalStatus"
										},
										"stale": {
											"type": "boolean"
										},
										"generatedAt": {
											"type": "string",
											"format": "date-time"
										},
										"updatedAt": {
											"type": "string",
											"format": "date-time"
										}
									}
								}
							}
						}
					},
					"404": {
						"description": "Unknown page",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"error": {
											"type": "object",
											"properties": {
												"code": {
													"type": "string"
												},
												"message": {
													"type": "string"
												},
												"details": {
													"type": "object",
													"additionalProperties": true
												}
											},
											"required": ["code", "message"]
										}
									},
									"required": ["error"]
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/pages/{slug}/components": {
			"get": {
				"summary": "Public components",
				"parameters": [
					{
						"name": "slug",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Visible components only",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"items": {
											"type": "array",
											"items": {
												"$ref": "#/components/schemas/PublicComponent"
											}
										}
									}
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/pages/{slug}/incidents": {
			"get": {
				"summary": "Active or resolved public incidents",
				"parameters": [
					{
						"name": "slug",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "status",
						"in": "query",
						"schema": {
							"type": "string",
							"enum": ["active", "resolved", "all"]
						}
					},
					{
						"name": "limit",
						"in": "query",
						"schema": {
							"type": "integer",
							"minimum": 1,
							"maximum": 100
						}
					},
					{
						"name": "cursor",
						"in": "query",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Paginated incidents",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PaginatedIncidents"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/pages/{slug}/incidents/{incidentId}": {
			"get": {
				"summary": "Public incident detail with its public timeline",
				"parameters": [
					{
						"name": "slug",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "incidentId",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Incident detail",
						"content": {
							"application/json": {
								"schema": {
									"$ref": "#/components/schemas/PublicIncident"
								}
							}
						}
					},
					"404": {
						"description": "Unknown or non-public incident",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"error": {
											"type": "object",
											"properties": {
												"code": {
													"type": "string"
												},
												"message": {
													"type": "string"
												},
												"details": {
													"type": "object",
													"additionalProperties": true
												}
											},
											"required": ["code", "message"]
										}
									},
									"required": ["error"]
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/pages/{slug}/incidents/{incidentId}/updates": {
			"get": {
				"summary": "Paginated public updates of an incident",
				"parameters": [
					{
						"name": "slug",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "incidentId",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "limit",
						"in": "query",
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "cursor",
						"in": "query",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Paginated updates",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/pages/{slug}/uptime": {
			"get": {
				"summary": "Daily uptime rollup of the public components (90 days)",
				"parameters": [
					{
						"name": "slug",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "componentId",
						"in": "query",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Daily uptime per component",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/pages/{slug}/maintenances": {
			"get": {
				"summary": "Scheduled or in-progress public maintenances",
				"parameters": [
					{
						"name": "slug",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "status",
						"in": "query",
						"schema": {
							"type": "string",
							"enum": ["scheduled", "in_progress", "completed", "all"]
						}
					},
					{
						"name": "limit",
						"in": "query",
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "cursor",
						"in": "query",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Paginated maintenances",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/pages/{slug}/history": {
			"get": {
				"summary": "Combined public history (incidents and maintenances)",
				"parameters": [
					{
						"name": "slug",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "from",
						"in": "query",
						"schema": {
							"type": "string",
							"format": "date-time"
						}
					},
					{
						"name": "to",
						"in": "query",
						"schema": {
							"type": "string",
							"format": "date-time"
						}
					},
					{
						"name": "componentId",
						"in": "query",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "state",
						"in": "query",
						"schema": {
							"type": "string"
						}
					},
					{
						"name": "limit",
						"in": "query",
						"schema": {
							"type": "integer"
						}
					},
					{
						"name": "cursor",
						"in": "query",
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "Paginated history",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/pages/{slug}/feed.xml": {
			"get": {
				"summary": "RSS 2.0 feed of published incidents",
				"parameters": [
					{
						"name": "slug",
						"in": "path",
						"required": true,
						"schema": {
							"type": "string"
						}
					}
				],
				"responses": {
					"200": {
						"description": "RSS XML"
					}
				}
			}
		},
		"/api/v1/openapi.json": {
			"get": {
				"summary": "This document",
				"responses": {
					"200": {
						"description": "OpenAPI document",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					}
				}
			}
		},
		"/healthz": {
			"get": {
				"summary": "Liveness probe",
				"responses": {
					"200": {
						"description": "Process alive",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					}
				}
			}
		},
		"/readyz": {
			"get": {
				"summary": "Readiness probe (includes storage)",
				"responses": {
					"200": {
						"description": "Ready",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					},
					"503": {
						"description": "Storage unavailable",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"error": {
											"type": "object",
											"properties": {
												"code": {
													"type": "string"
												},
												"message": {
													"type": "string"
												},
												"details": {
													"type": "object",
													"additionalProperties": true
												}
											},
											"required": ["code", "message"]
										}
									},
									"required": ["error"]
								}
							}
						}
					}
				}
			}
		},
		"/api/v1/admin/pages": {
			"get": {
				"summary": "List pages including internal settings (read)",
				"security": [
					{
						"bearerAuth": ["read"]
					}
				],
				"responses": {
					"200": {
						"description": "Pages",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					},
					"401": {
						"description": "Missing credentials",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"error": {
											"type": "object",
											"properties": {
												"code": {
													"type": "string"
												},
												"message": {
													"type": "string"
												},
												"details": {
													"type": "object",
													"additionalProperties": true
												}
											},
											"required": ["code", "message"]
										}
									},
									"required": ["error"]
								}
							}
						}
					}
				}
			},
			"post": {
				"summary": "Create a status page (write)",
				"security": [
					{
						"bearerAuth": ["write"]
					}
				],
				"parameters": [
					{
						"name": "Idempotency-Key",
						"in": "header",
						"required": false,
						"schema": {
							"type": "string",
							"maxLength": 200
						},
						"description": "Replaying the same key with the same body returns the stored response instead of acting twice."
					}
				],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"$ref": "#/components/schemas/CreatePage"
							}
						}
					}
				},
				"responses": {
					"201": {
						"description": "Created page",
						"content": {
							"application/json": {
								"schema": {
									"type": "object"
								}
							}
						}
					},
					"409": {
						"description": "Slug taken",
						"content": {
							"application/json": {
								"schema": {
									"type": "object",
									"properties": {
										"error": {
											"type": "object",
											"properties": {
												"code": {
													"type": "string"
												},
												"message": {
													"type": "string"
												},
												"details": {
													"type": "object",
													"additionalProperties": true
												}
											},
											"required": ["code", "message"]
										}
									},
									"required": ["error"]
								}
							}
						}
					}
				}
			}
		},
