{
	"name": "@notploy/status",
	"version": "0.1.0",
	"description": "Notploy Status — independent status page platform engine for the Notploy and SGE ecosystems: domain model, state computation, persistence, public/admin/integration HTTP API, notification outbox and integration client.",
	"type": "module",
	"license": "Apache-2.0",
	"private": false,
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./api": "./src/api/index.ts",
		"./client": "./src/integration/client.ts"
	},
	"files": [
		"dist",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/skygenesisenterprise/notploy.git",
		"directory": "packages/status"
	},
	"homepage": "https://github.com/skygenesisenterprise/notploy/tree/master/packages/status#readme",
	"bugs": {
		"url": "https://github.com/skygenesisenterprise/notploy/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "tsx esbuild.config.ts",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"token:create": "tsx src/cli/token-create.ts",
		"token:revoke": "tsx src/cli/token-revoke.ts",
		"seed": "tsx src/cli/seed.ts",
		"backup": "tsx src/cli/backup.ts",
		"generate:openapi": "tsx scripts/generate-openapi.ts"
	},
	"dependencies": {
		"hono": "^4.11.7",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/node": "^24.19.0",
		"esbuild": "0.28.2",
		"tsx": "^4.22.4",
		"typescript": "^7.0.2",
		"vitest": "^4.1.6"
	},
	"engines": {
		"node": ">=22.5.0"
	},
	"packageManager": "pnpm@10.22.0"
}
