# Notploy GitHub App — example environment file.
#
# Copy to `.env` and fill in the values. NEVER commit the real `.env`:
# credentials are provided at runtime only (env vars or a secret manager).

# GitHub App ID (from the GitHub App settings page)
GITHUB_APP_ID=123456

# PEM-encoded private key generated for the GitHub App.
# Single-line form with escaped newlines is accepted: "-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GITHUB_APP_PRIVATE_KEY=

# Optional: default installation ID used by the GitHub client
GITHUB_INSTALLATION_ID=

# Webhook secret configured in the GitHub App settings (used to verify X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=

# GitHub API base URL (github.com, GHES or a ghe.com data-residency tenant)
GITHUB_BASE_URL=https://api.github.com

# Base URL of the Notploy API for callbacks
NOTPLOY_API_URL=http://localhost:3000

# Host port exposed by docker-compose
EXTERNAL_PORT=3000
