{
	"name": "@notploy/github",
	"version": "0.1.0",
	"description": "Official GitHub integration layer for Notploy: typed repositories, deployments, checks, webhooks and GitHub App authentication",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepublishOnly": "pnpm run build"
	},
	"keywords": [
		"notploy",
		"github",
		"octokit",
		"github-app",
		"deployments",
		"webhooks"
	],
	"author": "Notploy",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/skygenesisenterprise/notploy.git",
		"directory": "packages/github"
	},
	"bugs": {
		"url": "https://github.com/skygenesisenterprise/notploy/issues"
	},
	"homepage": "https://github.com/skygenesisenterprise/notploy/tree/master/packages/github#readme",
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=20.0.0"
	},
	"dependencies": {
		"@octokit/auth-app": "^6.1.3",
		"@octokit/webhooks": "^13.9.0",
		"octokit": "3.1.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@types/node": "^24.4.0",
		"typescript": "^5.8.3",
		"vitest": "^4.1.6"
	},
	"packageManager": "pnpm@10.22.0"
}
