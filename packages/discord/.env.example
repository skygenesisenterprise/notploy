# ---------------------------------------------------------------------------
# Notploy Community Discord bot — environment variables
#
# Copy this file to `.env` and fill in the values. Never commit real secrets.
# ---------------------------------------------------------------------------

# --- Discord application (required) ----------------------------------------
# Bot token from the Discord Developer Portal → Application → Bot.
DISCORD_TOKEN=
# Application (client) ID used to register slash commands.
DISCORD_CLIENT_ID=

# --- Command registration (optional) ---------------------------------------
# When set, slash commands are registered to this single guild (instant).
# Leave empty to register globally (can take up to ~1 hour to propagate).
DISCORD_GUILD_ID=

# --- Official community resources (optional, sane defaults) ----------------
NOTPLOY_WEBSITE_URL=https://notploy.com
NOTPLOY_DOCS_URL=https://docs.notploy.com
NOTPLOY_STATUS_URL=https://status.notploy.com
NOTPLOY_TEMPLATES_URL=https://templates.notploy.com
NOTPLOY_CLOUD_URL=https://app.notploy.com
NOTPLOY_DISCORD_INVITE=https://discord.gg/GUkDugVh34
GITHUB_REPOSITORY=skygenesisenterprise/notploy

# --- Onboarding (optional) -------------------------------------------------
# Channel where new members are welcomed and the community role to grant.
DISCORD_WELCOME_CHANNEL_ID=
DISCORD_MEMBER_ROLE_ID=

# --- GitHub notifications (optional) ---------------------------------------
# Comma-separated list of event types to announce. Supported values:
# releases, issues, pullRequests, discussions, security
DISCORD_NOTIFICATION_EVENTS=
DISCORD_RELEASES_CHANNEL_ID=
DISCORD_ISSUES_CHANNEL_ID=
DISCORD_PULL_REQUESTS_CHANNEL_ID=
DISCORD_DISCUSSIONS_CHANNEL_ID=
DISCORD_SECURITY_CHANNEL_ID=

# --- Notploy API read-only integration (optional) --------------------------
# If set, /status and /version query the public Notploy API through
# @notploy/sdk. The bot never performs privileged or destructive operations.
NOTPLOY_URL=
NOTPLOY_API_KEY=
