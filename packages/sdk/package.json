{
  "name": "@notploy/sdk",
  "version": "1.0.1",
  "description": "TypeScript SDK for the Notploy API",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "notploy",
    "sdk",
    "api"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/skygenesisenterprise/notploy.git",
    "directory": "packages/sdk"
  },
  "author": "Notploy",
  "license": "ISC",
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@hey-api/openapi-ts": "^0.97.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  }
}
