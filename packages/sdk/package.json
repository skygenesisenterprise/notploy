{
  "name": "@notploy/sdk",
  "version": "0.30.7",
  "description": "TypeScript SDK for the Notploy API",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate": "openapi-ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm run build"
  },
  "keywords": [
    "notploy",
    "sdk",
    "api"
  ],
  "author": "Notploy",
  "license": "ISC",
  "packageManager": "pnpm@10.30.1",
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@hey-api/openapi-ts": "^0.97.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
