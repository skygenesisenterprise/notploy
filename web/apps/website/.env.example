# --- Notploy Traffic Manager instrumentation --------------------------------
# Both values come from Notploy: Dashboard > Website > Traffic > Platforms &
# sources > Install, on the property that represents this site. Without them the
# instrumentation is not loaded at all and no audience data is collected.
# NEXT_PUBLIC_NOTPLOY_TRAFFIC_ENDPOINT=https://<notploy-host>
# NEXT_PUBLIC_NOTPLOY_TRAFFIC_KEY=pk_...
