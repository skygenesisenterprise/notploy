DATABASE_URL="postgres://notploy:amukds4wi9001583845717ad2@localhost:5432/notploy"
PORT=3000
NODE_ENV=development

# Templates are read from ../templates/blueprints when that directory exists
# (auto-detected by walking up from the working directory), so local dev never
# depends on https://templates.notploy.com. Set this only to force another path.
# NOTPLOY_TEMPLATES_DIR=/absolute/path/to/templates/blueprints

# Ghost Content API, used by the console Website > Blog page. Point these at the
# same Ghost site that powers web/apps/website.
# GHOST_URL=https://blog.notploy.com
# GHOST_KEY=42424242424242424242424242424242
# Ghost Admin API key (<id>:<secret>), required to publish posts from the console.
# GHOST_ADMIN_KEY=0123456789abcdef0123456789:0123456789abcdef0123456789abcdef
