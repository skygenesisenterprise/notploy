		"react-dom": "19.2.7",
		"tailwind-merge": "^2.6.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@tailwindcss/postcss": "^4.3.1",
		"@types/node": "^24.4.0",
		"@types/react": "18.3.5",
		"@types/react-dom": "18.3.0",
		"postcss": "^8.5.3",
		"tailwindcss": "^4.3.1",
		"tsx": "^4.22.4",
		"typescript": "^7.0.2",
		"vite-tsconfig-paths": "4.3.2",
