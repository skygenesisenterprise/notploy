{
  "name": "@notploy/voyager",
  "version": "1.0.0",
  "private": true,
  "description": "Notploy Voyager - Official mobile application for Notploy",
  "main": "expo/AppEntry.js",
  "scripts": {
    "dev": "expo start --clear",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo prebuild",
    "build:android": "expo prebuild --platform android",
    "build:ios": "expo prebuild --platform ios",
    "build:web": "expo prebuild --platform web",
    "eas:build": "eas build",
    "eas:build:android": "eas build --platform android",
    "eas:build:ios": "eas build --platform ios",
    "eas:update": "eas update",
    "eas:deploy": "eas deploy",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@notploy/sdk": "workspace:*",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.9.17",
    "@tanstack/react-query": "^5.59.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "expo": "58.0.7",
    "expo-blur": "58.0.3",
    "expo-build-properties": "0.12.0",
    "expo-constants": "16.0.1",
    "expo-device": "6.0.1",
    "expo-file-system": "58.0.10",
    "expo-haptics": "13.0.1",
    "expo-image": "2.0.1",
    "expo-image-picker": "15.0.1",
    "expo-linear-gradient": "13.0.1",
    "expo-linking": "7.0.1",
    "expo-localization": "15.0.1",
    "expo-notifications": "0.28.0",
    "expo-router": "3.4.1",
    "expo-secure-store": "13.0.1",
    "expo-sharing": "13.0.1",
    "expo-splash-screen": "0.28.0",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "3.0.1",
    "expo-web-browser": "58.0.6",
    "react": "18.2.0",
    "react-native": "0.73.2",
    "react-native-gesture-handler": "2.14.0",
    "react-native-pager-view": "6.3.0",
    "react-native-reanimated": "3.6.0",
    "react-native-safe-area-context": "4.8.2",
    "react-native-screens": "3.29.0",
    "react-native-svg": "13.14.0",
    "react-native-url-polyfill": "2.0.0",
    "zustand": "4.4.7",
    "nativewind": "4.1.0",
    "tailwindcss": "3.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@biomejs/biome": "^2.5.15",
    "@testing-library/jest-native": "5.4.3",
    "@testing-library/react-native": "12.5.0",
    "@types/react": "^18.2.45",
    "jest": "^29.7.0",
    "jest-expo": "58.0.0",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.3.0"
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": "^24.4.0",
    "pnpm": ">=10.22.0"
  }
}
