{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"baseUrl": ".",
		"paths": {
			"@/*": ["src/*"],
			"@/lib/*": ["src/lib/*"],
			"@/components/*": ["src/components/*"],
			"@/hooks/*": ["src/hooks/*"],
			"@/types/*": ["src/types/*"],
			"@/services/*": ["src/services/*"],
			"@/stores/*": ["src/stores/*"],
			"@/utils/*": ["src/utils/*"]
		},
		"skipLibCheck": true,
		"allowJs": true,
		"esModuleInterop": true,
		"lib": ["dom", "esnext"],
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"noEmit": true,
		"jsx": "preserve"
	},
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules", "dist", "web-build"]
}
