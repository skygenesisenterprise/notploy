# Notploy — self-hosted / cloud configuration.
#
#   cp .env.example .env
#
# Replace every placeholder before exposing the instance. The defaults in
# docker-compose.yml only exist so `docker compose config` works out of the box;
# they are NOT safe for production.

# --- Image / edition -----------------------------------------------------
# There is ONE image for every mode and edition: `notploy`. Development builds
# the same image with the `dev` tag/target; only the runtime mode changes.
# NOTPLOY_FLAVOR selects the edition at runtime: `selfhosted` (self, default) or
# `cloud`. The Makefile derives NOTPLOY_PRODUCT and IS_CLOUD from it; override
# the image for a mirror, or drive `docker compose` directly.
# `make docker-up -- --self|--cloud` sets them for a single invocation.
NOTPLOY_FLAVOR=selfhosted
NOTPLOY_IMAGE=ghcr.io/skygenesisenterprise/notploy
NOTPLOY_VERSION=latest
# IS_CLOUD=true switches the app to cloud behaviour (managed queue, billing...).
# Set automatically for the cloud edition; keep it in sync if you set the
# flavor by hand.
IS_CLOUD=false
# Explicit edition override (self | cloud). Leave empty to derive it from
# NOTPLOY_FLAVOR / IS_CLOUD. Cloud requires a signed entitlement.
NOTPLOY_PRODUCT=

# --- Networking ----------------------------------------------------------
# Host port of the dashboard (client service). Production (`make docker-up`) and
# development (`make docker-dev`) both publish it, so the app is always reachable
# at http://localhost:3000 whichever mode you run (only one mode at a time).
NOTPLOY_PORT=3000

# Host port of the API service (`api` role). The browser opens WebSockets here
# and server-side `/api/*` calls are proxied from the client over the internal
# network. NEXT_PUBLIC_API_URL is baked into the browser bundle at build time,
# so rebuild the image if you change this port.
NOTPLOY_API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Public hostname of the dashboard in production (Traefik router). `make
# docker-dev` uses app.notploy.localhost / api.notploy.localhost instead;
# make docker-up requires a real NOTPLOY_APP_HOST.
NOTPLOY_APP_HOST=app.example.com

# Host port the Notploy DNS server is published on in production (the container
# always listens on 53). It must be free on the host: systemd-resolved
# (127.0.0.53), dnsmasq or Pi-hole take 53 on most distros and the container
# then fails to start with "listen tcp4 0.0.0.0:53: bind: address already in
# use". Check with `ss -lntu | grep :53` and pick a free port if needed.
NOTPLOY_DNS_HOST_PORT=53

# Same, for the development stack (`make docker-dev`): it defaults to 5300 so
# the dev server starts on a machine where something already holds 53. Query it
# with `dig @127.0.0.1 -p 5300`.
NOTPLOY_DNS_DEV_HOST_PORT=5300

# --- Notploy Cloud generated domains -------------------------------------
# Managed Cloud assigns `<app>.notploy.app` automatically after a successful
# deployment. Self-hosted never allocates. Leave the zone unset to keep
# the managed-cloud default, or set it empty to disable allocation.
# NOTPLOY_CLOUD_DOMAIN=notploy.app
# Central Cloudflare zone used to resolve the wildcard. Use a token scoped to
# Zone:Read + DNS:Edit for that zone only; ownership stays in Notploy's
# database. Without these two values the wildcard is assumed to be managed
# outside Notploy and DNS provisioning is skipped.
# CLOUDFLARE_API_TOKEN=
# IP (A/AAAA) or hostname (CNAME) of the Cloud ingress.
# NOTPLOY_CLOUD_INGRESS_TARGET=
# Optional: pin the Cloudflare zone id instead of resolving it by name.
# NOTPLOY_CLOUD_DNS_ZONE_ID=
# Proxied by default (Cloudflare terminates TLS at the edge); false = DNS-only,
# in which case Traefik issues a certificate per generated hostname.
# NOTPLOY_CLOUD_DNS_PROXIED=true
# Optional Traefik resolver for a pre-provisioned wildcard certificate.
# NOTPLOY_CLOUD_CERT_RESOLVER=

# --- Database ------------------------------------------------------------
POSTGRES_USER=notploy
POSTGRES_DB=notploy
# CHANGE ME — generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change-me-postgres-password
# Password of the Compose-managed Redis service. docker-compose.yml builds
# REDIS_URL from it, so an external REDIS_URL is no longer needed for the
# standard stack. CHANGE ME before exposing the instance.
REDIS_PASSWORD=change-me-redis-password

# --- Authentication ------------------------------------------------------
# CHANGE ME — session signing secret, generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-better-auth-secret

# --- Misc ----------------------------------------------------------------
TZ=UTC
